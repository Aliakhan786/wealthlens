# Copy to .env and fill in what you need. Everything is optional — the app runs with zero config.

# --- Database ---------------------------------------------------------------
# Default: SQLite file at ./data/wealthlens.db (no setup).
# Postgres (Supabase / Neon / docker-compose):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/wealthlens

# --- Cache ------------------------------------------------------------------
# Default: in-memory. Upstash / docker-compose Redis:
# REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# --- AI ---------------------------------------------------------------------
# Without a key, AI features use deterministic offline fallbacks.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5

# --- Pipeline ---------------------------------------------------------------
# LIVE_INTERVAL_MINUTES=2
# ENABLE_SCHEDULER=true
# OFFLINE_MODE=false          # true = deterministic sample data, no internet needed

# --- API --------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# RATE_LIMIT=120/minute
# AI_RATE_LIMIT=15/minute

# --- Monitoring -------------------------------------------------------------
# SENTRY_DSN=https://...ingest.sentry.io/...
# ENVIRONMENT=production
